# Password that protects your library. Leave empty to run with no login (only do that on a private network).
POSTMARK_PASSWORD=harsha
# Used to sign login cookies. Any long random string. Defaults to the password.
POSTMARK_SECRET=harshavardhan-123
# Where the database file and your audio live. Mount this as a persistent volume when deploying.
DATA_DIR=./data
# Required when deployed to Vercel: use a hosted libSQL/Turso database instead of the local file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# Supabase Storage for audio and cover files (keep the service role key server-side).
# Create a private bucket with this name in Supabase Storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=postmark-audio
